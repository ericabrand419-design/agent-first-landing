    { key: 'idverify', ruleIndex: 1, label: 'ID Verification' },
    { key: 'refund', ruleIndex: 2, label: 'Refund Sign-Off' },
    { key: 'callback', ruleIndex: 3, label: 'Callback Window' }
  ];

  var ROUNDS = [
    { client: 'C', categoryKey: 'refund', ask: 'A Northgate customer is owed a $275 refund. What do you tell them about getting it processed?' },
    { client: 'B', categoryKey: 'idverify', ask: 'A Meridian customer calls with a general question about their account balance. What do you tell them about ID verification?' },
    { client: 'A', categoryKey: 'callback', ask: 'A Harborview customer has an open issue and it is a Friday afternoon. When should they expect a callback?' }
  ];

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function shuffle(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }

  function categoryByKey(key) {
    for (var i = 0; i < CATEGORIES.length; i++) { if (CATEGORIES[i].key === key) return CATEGORIES[i]; }
    return null;
  }

  var introStage = $('introStage'), gameStage = $('gameStage'), resultsStage = $('resultsStage');
  var flash = $('flash');
  var state = null;

  function startGame() {
    state = {
      roundIndex: 0,
      roundResults: [],
      running: true,
      locked: false,
      playerStartTime: 0,
      playerTickInterval: null,
      agentTimers: [],
      agentResolveMs: 0,
      currentRound: null
    };
    introStage.style.display = 'none';
    resultsStage.style.display = 'none';
    gameStage.style.display = 'flex';
    startRound();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function startRound() {
    var round = ROUNDS[state.roundIndex];
    state.currentRound = round;
    state.locked = false;

    $('roundBadge').textContent = 'Round ' + (state.roundIndex + 1) + ' of ' + ROUNDS.length;
    $('scenarioText').textContent = round.ask;
    $('roundSummary').style.display = 'none';

    rebuildAccordion();
    resetAgentPanel(round);

    state.agentResolveMs = 1100 + Math.floor(Math.random() * 600);
    scheduleAgentSteps(state.agentResolveMs);

    state.playerStartTime = Date.now();
    clearInterval(state.playerTickInterval);
    updatePlayerTimerDisplay();
    state.playerTickInterval = setInterval(updatePlayerTimerDisplay, 100);
  }

  function updatePlayerTimerDisplay() {
    var elapsed = (Date.now() - state.playerStartTime) / 1000;
    $('playerTimerChip').textContent = elapsed.toFixed(1) + 's';
  }

  function resetAgentPanel(round) {
    ['agentStep1', 'agentStep2', 'agentStep3'].forEach(function (id) { $(id).classList.remove('done'); });
    $('agentStep1Text').textContent = 'Matching call to Client Profile: ' + CLIENTS[round.client].name;
    $('agentStep2Text').textContent = 'Locating the active rule: ' + categoryByKey(round.categoryKey).label;
    $('agentStep3Text').textContent = 'Rule applied.';
    $('agentTimerChip').textContent = '--';
  }

  function clearAgentTimers() {
    state.agentTimers.forEach(function (t) { clearTimeout(t); });
    state.agentTimers = [];
  }

  function scheduleAgentSteps(ms) {
    clearAgentTimers();
    var t1 = Math.round(ms * 0.32);
    var t2 = Math.round(ms * 0.66);
    state.agentTimers.push(setTimeout(function () { markStepDone(1); }, t1));
    state.agentTimers.push(setTimeout(function () { markStepDone(2); }, t2));
    state.agentTimers.push(setTimeout(function () { markStep3Resolved(ms); }, ms));
  }

  function markStepDone(n) {
    $('agentStep' + n).classList.add('done');
  }

  function markStep3Resolved(ms) {
    markStepDone(3);
    $('agentStep3Text').textContent = 'Resolved in ' + (ms / 1000).toFixed(1) + 's. Answer ready.';
    $('agentTimerChip').textContent = (ms / 1000).toFixed(1) + 's';
  }

  function rebuildAccordion() {
    var wrap = $('accordionWrap');
    wrap.innerHTML = '';
    CATEGORIES.forEach(function (cat) {
      var section = document.createElement('div');
      section.className = 'baf-accordion-section';

      var header = document.createElement('button');
      header.type = 'button';
      header.className = 'baf-accordion-header';
      header.innerHTML = '<span>' + escapeHtml(cat.label) + '</span><span class="baf-accordion-toggle">Expand</span>';

      var body = document.createElement('div');
      body.className = 'baf-accordion-body';

      var order = shuffle(CLIENT_KEYS);
      order.forEach(function (ck) {
        var ruleText = CLIENTS[ck].rules[cat.ruleIndex];
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'baf-entry';
        btn.innerHTML = '<span class="bec">' + escapeHtml(CLIENTS[ck].name) + '</span>' + escapeHtml(ruleText);
        btn.addEventListener('click', function () { selectAnswer(cat.key, ck, ruleText, btn); });
        body.appendChild(btn);
      });

      header.addEventListener('click', function () {
        var isOpen = body.classList.toggle('open');
        header.querySelector('.baf-accordion-toggle').textContent = isOpen ? 'Collapse' : 'Expand';
      });

      section.appendChild(header);
      section.appendChild(body);
      wrap.appendChild(section);
    });
  }

  function disableAllEntries() {
    document.querySelectorAll('.baf-entry').forEach(function (b) {
      b.disabled = true;
      b.classList.add('is-disabled');
    });
  }

  function flashScreen(kind) {
    flash.className = 'baf-flash show ' + kind;
    setTimeout(function () { flash.className = 'baf-flash'; }, 260);
  }

  function selectAnswer(categoryKey, clientKey, ruleText, btnEl) {
    if (!state.running || state.locked) return;
    state.locked = true;
    clearInterval(state.playerTickInterval);
    var playerMs = Date.now() - state.playerStartTime;
    updatePlayerTimerDisplay();

    markStepDone(1);
    markStepDone(2);
    markStep3Resolved(state.agentResolveMs);
    clearAgentTimers();

    var round = state.currentRound;
    var playerCorrect = (categoryKey === round.categoryKey && clientKey === round.client);

    btnEl.classList.add(playerCorrect ? 'is-correct' : 'is-wrong');
    disableAllEntries();
    flashScreen(playerCorrect ? 'correct' : 'wrong');

    var agentMs = state.agentResolveMs;
    var speedWinner = playerMs <= agentMs ? 'player' : 'agent';
    var correctRuleText = CLIENTS[round.client].rules[categoryByKey(round.categoryKey).ruleIndex];

    state.roundResults.push({
      playerMs: playerMs, agentMs: agentMs, playerCorrect: playerCorrect, speedWinner: speedWinner
    });

    renderRoundSummary(CLIENTS[clientKey].name, ruleText, playerCorrect, playerMs, agentMs, speedWinner, CLIENTS[round.client].name, correctRuleText);
  }

  function renderRoundSummary(pickedClientName, pickedText, playerCorrect, playerMs, agentMs, speedWinner, correctClientName, correctText) {
    var badges = '';
    badges += speedWinner === 'player'
      ? '<div class="pill pill-green">You answered first</div>'
      : '<div class="pill pill-violet">Agent First answered first</div>';
    badges += playerCorrect
      ? '<div class="pill pill-green">Correct client and rule</div>'
      : '<div class="pill pill-danger">Wrong match</div>';
    $('summaryBadges').innerHTML = badges;

    $('summaryYourRow').innerHTML =
      '<div class="baf-reveal-label">Your answer</div>' +
      '<div class="ds-body-sm"><span style="font-weight:750;">' + escapeHtml(pickedClientName) + ':</span> ' + escapeHtml(pickedText) + '</div>';

    $('summaryAgentRow').innerHTML =
      '<div class="baf-reveal-label">Agent First\'s match</div>' +
      '<div class="ds-body-sm"><span style="font-weight:750;">' + escapeHtml(correctClientName) + ':</span> ' + escapeHtml(correctText) + '</div>';

    $('summaryTimes').textContent = 'Your time: ' + (playerMs / 1000).toFixed(1) + 's. Agent First: ' + (agentMs / 1000).toFixed(1) + 's.';

    var isLastRound = state.roundIndex + 1 >= ROUNDS.length;
    $('continueBtn').textContent = isLastRound ? 'See your results' : 'Next round';

    $('roundSummary').style.display = 'block';
  }

  function continueRound() {
    state.roundIndex += 1;
    if (state.roundIndex < ROUNDS.length) {
      startRound();
    } else {
      endGame();
    }
  }

  function endGame() {
    state.running = false;
    gameStage.style.display = 'none';
    resultsStage.style.display = 'flex';

    var speedWinsPlayer = 0, correctCount = 0, totalPlayerMs = 0, totalAgentMs = 0;
    state.roundResults.forEach(function (r) {
      if (r.speedWinner === 'player') speedWinsPlayer += 1;
      if (r.playerCorrect) correctCount += 1;
      totalPlayerMs += r.playerMs;
      totalAgentMs += r.agentMs;
    });
    var speedWinsAgent = ROUNDS.length - speedWinsPlayer;
    var accuracy = Math.round((correctCount / ROUNDS.length) * 100);
    var avgPlayer = totalPlayerMs / ROUNDS.length / 1000;
    var avgAgent = totalAgentMs / ROUNDS.length / 1000;

    $('rSpeedWins').textContent = speedWinsPlayer + '/' + ROUNDS.length;
    $('rAccuracy').textContent = accuracy + '%';
    $('rYourAvg').textContent = avgPlayer.toFixed(1) + 's';
    $('rAgentAvg').textContent = avgAgent.toFixed(1) + 's';

    var headline;
    if (correctCount < ROUNDS.length && speedWinsPlayer >= 2) {
      headline = 'You out-ran Agent First in ' + speedWinsPlayer + ' of ' + ROUNDS.length + ' rounds, but only got ' + correctCount + ' of ' + ROUNDS.length + ' exactly right. Fast and wrong still reaches the wrong client.';
    } else if (speedWinsPlayer === 0) {
      headline = 'Agent First matched client and topic automatically in all ' + ROUNDS.length + ' rounds, faster than you could open the right section even once.';
    } else if (correctCount === ROUNDS.length && speedWinsPlayer === ROUNDS.length) {
      headline = 'Perfect accuracy, and faster than Agent First in every round. Genuinely quick work, on three calls. Now multiply that gap across a full shift.';
    } else if (correctCount === ROUNDS.length) {
      headline = 'You got all ' + ROUNDS.length + ' exactly right, and still lost the race on speed ' + speedWinsAgent + ' out of ' + ROUNDS.length + ' times.';
    } else {
      headline = 'You beat Agent First on speed in ' + speedWinsPlayer + ' of ' + ROUNDS.length + ' rounds, with ' + correctCount + ' of ' + ROUNDS.length + ' exactly right.';
    }
    $('resultsHeadline').textContent = headline;

    var shareLine = 'I beat Agent First on speed in ' + speedWinsPlayer + ' of ' + ROUNDS.length + ' rounds (accuracy: ' + correctCount + '/' + ROUNDS.length + ') in Beat Agent First. Try it: myagentfirst.com/beat-agent-first.html';
    $('shareText').value = shareLine;
    $('resultSummaryField').value = shareLine;

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  $('startBtn').addEventListener('click', startGame);
  $('continueBtn').addEventListener('click', continueRound);
  $('playAgainBtn').addEventListener('click', function () {
    resultsStage.style.display = 'none';
    startGame();
  });

  $('copyBtn').addEventListener('click', function () {
    var field = $('shareText');
    field.select();
    var done = function () {
      $('copyStatus').style.display = 'block';
      setTimeout(function () { $('copyStatus').style.display = 'none'; }, 1800);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(field.value).then(done).catch(function () {
        try { document.execCommand('copy'); done(); } catch (e) { /* clipboard unavailable */ }
      });
    } else {
      try { document.execCommand('copy'); done(); } catch (e) { /* clipboard unavailable */ }
    }
  });

  var emailForm = $('emailForm');
  emailForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var btn = emailForm.querySelector('button[type="submit"]');
    var status = $('emailStatus');
    var original = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Sending...';
    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new FormData(emailForm)
    }).then(function (r) { return r.json(); }).then(function (data) {
      if (data && data.success) {
        emailForm.style.display = 'none';
        status.style.color = '#1f5c42';
        status.textContent = "Sent. I'll follow up directly too.";
        status.style.display = 'block';
      } else {
        btn.disabled = false;
        btn.textContent = original;
        status.style.color = '#c53636';
        status.textContent = 'Something went wrong. Please try again, or email info@myagentfirst.com directly.';
        status.style.display = 'block';
      }
    }).catch(function () {
      btn.disabled = false;
      btn.textContent = original;
      status.style.color = '#c53636';
      status.textContent = 'Something went wrong. Please try again, or email info@myagentfirst.com directly.';
      status.style.display = 'block';
    });
  });
})();
</script>

</body>
</html>
