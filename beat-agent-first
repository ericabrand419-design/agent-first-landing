            <div class="pill pill-violet">Agent First</div>
            <div class="baf-timer-chip" id="agentTimerChip">--</div>
          </div>
          <div class="baf-steps">
            <div class="baf-step" id="agentStep1">
              <div class="baf-step-icon">1</div>
              <div class="baf-step-text"><span class="baf-step-label">Find</span><span id="agentStep1Text">Matching call to Client Profile...</span></div>
            </div>
            <div class="baf-step" id="agentStep2">
              <div class="baf-step-icon">2</div>
              <div class="baf-step-text"><span class="baf-step-label">Interpret</span><span id="agentStep2Text">Locating the active rule...</span></div>
            </div>
            <div class="baf-step" id="agentStep3">
              <div class="baf-step-icon">3</div>
              <div class="baf-step-text"><span class="baf-step-label">Act</span><span id="agentStep3Text">Rule applied.</span></div>
            </div>
          </div>
          <p class="ds-body-sm" style="color:var(--muted);margin-top:14px;">The rule itself stays hidden until you answer, so this cannot just hand you the result. Only the timing shows.</p>
        </div>

      </div>

      <div class="card baf-summary" id="roundSummary">
        <div class="baf-badge-row" id="summaryBadges"></div>
        <div class="baf-reveal-row" id="summaryYourRow"></div>
        <div class="baf-reveal-row" id="summaryAgentRow"></div>
        <div class="ds-body-sm" style="color:var(--muted);margin-bottom:14px;" id="summaryTimes"></div>
        <button class="btn btn-primary" id="continueBtn">Next round</button>
      </div>

    </div>
  </div>

  <!-- RESULTS STAGE -->
