      <div class="baf-round-row">
        <div class="pill pill-violet" id="roundBadge">Round 1 of 3</div>
        <div class="ds-body-sm" style="color:var(--muted);">Reset each round: a fresh scenario, a fresh timer, the same shared knowledge base.</div>
      </div>

      <div class="card" style="margin-top:16px;">
        <div class="ds-label eyebrow-c">Customer on the line</div>
        <div class="ds-heading" id="scenarioText" style="margin-top:6px;">&nbsp;</div>
