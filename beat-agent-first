<style>
  :root{
    --ink:#171a2b;--muted:#6d728b;--line:#e5e4f1;--bg:#f7f6fc;--panel:rgba(255,255,255,.94);--soft:#faf9ff;
    --navy:#0b1025;--violet:#7c3aed;--purplebg:#f4efff;--coral:#ff6b54;--pink:#e447d5;
    --green:#177a55;--greenbg:#ecfbf4;--amber:#a15c00;--amberbg:#fff6e5;--danger:#c5364a;--dangerbg:#fdeaee;
    --radius-sm:9px;--radius-md:12px;--radius-lg:18px;--radius-full:999px;
    --space-3:12px;--space-4:16px;--space-5:24px;
    --shadow-panel:0 12px 34px rgba(64,47,112,.07),0 2px 6px rgba(20,22,45,.035);
    --font-sans:'Inter',ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    --grad-primary:linear-gradient(102deg,var(--coral) 0%,var(--pink) 47%,var(--violet) 100%);
    --grad-navy:linear-gradient(105deg,#090e21 0%,#0e1430 60%,#14103a 100%);
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:var(--font-sans);color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased}
  h1,h2{margin:0}
  a{text-decoration:none}
  p{margin:0}
  button{font-family:inherit}
  input{font-family:inherit}

  .ds-label{font-size:11px;line-height:1.4;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .ds-body-sm{font-size:14px;line-height:1.55;font-weight:400}
  .ds-body{font-size:16px;line-height:1.55;font-weight:400}
  .ds-heading{font-size:18px;line-height:1.4;font-weight:900}
  .ds-score{font-size:28px;line-height:1;font-weight:900;letter-spacing:-.03em}
  .ds-hero{font-size:30px;line-height:1.1;font-weight:900;letter-spacing:-.02em}
  .ds-display{font-size:44px;line-height:1.08;font-weight:900;letter-spacing:-.015em}

  .wrap{width:100%;max-width:1100px;margin:0 auto}
  .section{width:100%;padding:88px 48px;display:flex;justify-content:center}
  .eyebrow-v{color:var(--violet)}
  .eyebrow-c{color:var(--coral)}
  .grid{display:grid;gap:var(--space-4)}

  .card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-panel)}
  .card-on-dark{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:var(--radius-lg);padding:24px}

  .btn{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:var(--radius-md);font-weight:750;font-size:15px;cursor:pointer;border:0;transition:transform .14s ease,filter .14s ease}
  .btn:hover{transform:translateY(-1px);filter:brightness(1.03)}
  .btn-primary{background:var(--grad-primary);color:#fff;box-shadow:0 8px 20px rgba(176,57,217,.22)}
  .btn-ghost-dark{background:rgba(255,255,255,.06);color:#fff;border:1.5px solid rgba(255,255,255,.4)}
  .btn-ghost-dark:hover{border-color:#fff}
  .btn-ghost-light{background:var(--soft);color:var(--ink);border:1px solid var(--line)}
  .btn:disabled{opacity:.5;cursor:not-allowed;transform:none}

  .logo-mark{display:block;flex:0 0 auto}
  .brand-row{display:flex;align-items:center;gap:12px}
  .brand-word{font-size:11px;font-weight:900;letter-spacing:.2em}

  .field-input{width:100%;padding:12px 16px;border-radius:var(--radius-md);border:1.5px solid var(--line);background:#fff;color:var(--ink);font-family:var(--font-sans);font-size:15px;transition:border-color .14s ease}
  .field-input:focus{outline:none;border-color:var(--violet)}

  .pill{display:inline-flex;align-items:center;padding:4px 10px;border-radius:var(--radius-full);font-size:11px;font-weight:750;text-transform:uppercase;letter-spacing:.04em;flex:0 0 auto;}
  .pill-violet{background:var(--purplebg);color:var(--violet)}
  .pill-green{background:var(--greenbg);color:var(--green)}
  .pill-danger{background:var(--dangerbg);color:var(--danger)}
  .pill-amber{background:var(--amberbg);color:var(--amber)}

  /* race layout */
  .baf-round-row{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
  .baf-race-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start;margin-top:16px;}
  .baf-panel-you{border-top:3px solid var(--coral);}
  .baf-panel-agent{border-top:3px solid var(--violet);}
  .baf-panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
  .baf-timer-chip{font-size:20px;font-weight:900;font-variant-numeric:tabular-nums;color:var(--ink);}

  .baf-scenario-hint{color:var(--muted);margin-top:8px;}

  .baf-accordion-section{border:1px solid var(--line);border-radius:11px;margin-bottom:8px;overflow:hidden;}
  .baf-accordion-header{width:100%;display:flex;align-items:center;justify-content:space-between;padding:11px 14px;background:var(--soft);border:0;cursor:pointer;font-family:inherit;font-weight:750;font-size:13.5px;color:var(--ink);}
  .baf-accordion-header:hover{background:var(--purplebg);}
  .baf-accordion-toggle{font-size:11px;font-weight:750;color:var(--violet);text-transform:uppercase;letter-spacing:.05em;}
  .baf-accordion-body{display:none;flex-direction:column;gap:6px;padding:10px;}
  .baf-accordion-body.open{display:flex;}

  .baf-entry{text-align:left;padding:10px 12px;border-radius:9px;border:1px solid var(--line);background:#fff;font-size:13px;line-height:1.5;cursor:pointer;color:var(--ink);}
  .baf-entry:hover{border-color:var(--violet);background:var(--purplebg);}
  .baf-entry .bec{font-weight:750;display:block;margin-bottom:2px;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);}
  .baf-entry.is-correct{border-color:var(--green);background:var(--greenbg);}
  .baf-entry.is-wrong{border-color:var(--danger);background:var(--dangerbg);}
  .baf-entry.is-disabled{cursor:default;}
  .baf-entry:disabled{cursor:default;}

  .baf-steps{display:flex;flex-direction:column;gap:10px;}
  .baf-step{display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:11px;border:1px solid var(--line);background:var(--soft);opacity:.5;transition:opacity .2s ease,border-color .2s ease,background .2s ease;}
  .baf-step.done{opacity:1;border-color:var(--green);background:var(--greenbg);}
  .baf-step-icon{flex:0 0 auto;width:22px;height:22px;border-radius:999px;border:2px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:var(--muted);background:#fff;}
  .baf-step.done .baf-step-icon{border-color:var(--green);background:var(--green);color:#fff;}
  .baf-step-text{font-size:13.5px;line-height:1.4;}
  .baf-step-label{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);display:block;margin-bottom:2px;}

  .baf-summary{margin-top:18px;display:none;}
  .baf-badge-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
  .baf-reveal-row{padding:12px 14px;border-radius:11px;border:1px solid var(--line);background:#fff;margin-bottom:10px;}
  .baf-reveal-label{font-size:11px;font-weight:750;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:4px;}

  .baf-flash{position:fixed;inset:0;pointer-events:none;opacity:0;transition:opacity .15s ease;z-index:40}
  .baf-flash.show{opacity:1}
  .baf-flash.correct{background:rgba(23,122,85,.10)}
  .baf-flash.wrong{background:rgba(197,54,74,.12)}

  @media (max-width:900px){
    .section{padding:56px 20px}
    .ds-display{font-size:32px}
    .ds-hero{font-size:24px}
  }
  @media (max-width:860px){
    .baf-race-grid{grid-template-columns:1fr;}
  }
</style>
</head>
