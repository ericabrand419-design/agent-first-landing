{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.myagentfirst.com"
        }
      ],
      "destination": "https://myagentfirst.com/:path*",
      "permanent": true
    },
    {
      "source": "/client-resolution.html",
      "destination": "/decision-resolution-time-calculator.html",
      "permanent": true
    },
    {
      "source": "/pilot-buisness-case-builder.html",
      "destination": "/pilot-business-case-builder.html",
      "permanent": true
    },
    {
      "source": "/insurance.html",
      "destination": "/for-insurance.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/deal-room",
      "destination": "/deal-room-workspace.html"
    },
    {
      "source": "/deal-room-v1",
      "destination": "/deal-room-v1.html"
    },
    {
      "source": "/pilot-prospectus",
      "destination": "/pilot-prospectus.html"
    },
    {
      "source": "/pilot-operations",
      "destination": "/pilot-operations.html"
    }
  ]
}
