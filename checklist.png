<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Free Checklist: Client Profile Setup | Agent First</title>
<meta name="description" content="The Client Profile Setup Checklist: what to gather before your first pilot call, free from Agent First.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;650;700;750;900&display=swap" rel="stylesheet">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-TGQ8RPR5B1"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-TGQ8RPR5B1');
</script>
<style>
  :root{
    --ink:#171a2b;--muted:#6d728b;--line:#e5e4f1;--bg:#f7f6fc;--panel:rgba(255,255,255,.94);--soft:#faf9ff;
    --navy:#0b1025;--violet:#7c3aed;--purplebg:#f4efff;--coral:#ff6b54;--pink:#e447d5;
    --green:#177a55;--greenbg:#ecfbf4;
    --radius-sm:9px;--radius-md:12px;--radius-lg:18px;--radius-full:999px;
    --space-3:12px;--space-4:16px;--space-5:24px;
    --shadow-panel:0 12px 34px rgba(64,47,112,.07),0 2px 6px rgba(20,22,45,.035);
    --font-sans:'Inter',ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    --grad-primary:linear-gradient(102deg,var(--coral) 0%,var(--pink) 47%,var(--violet) 100%);
    --grad-navy:linear-gradient(105deg,#090e21 0%,#0e1430 60%,#14103a 100%);
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:var(--font-sans);color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased}
  h1,h2{margin:0}
  a{text-decoration:none}
  p{margin:0}

  .ds-label{font-size:11px;line-height:1.4;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .ds-body-sm{font-size:14px;line-height:1.55;font-weight:400}
  .ds-body{font-size:16px;line-height:1.55;font-weight:400}
  .ds-heading{font-size:18px;line-height:1.4;font-weight:900}
  .ds-hero{font-size:30px;line-height:1.1;font-weight:900;letter-spacing:-.02em}
  .ds-display{font-size:44px;line-height:1.08;font-weight:900;letter-spacing:-.015em}

  .wrap{width:100%;max-width:1100px;margin:0 auto}
  .section{width:100%;padding:88px 48px;display:flex;justify-content:center}
  .eyebrow-v{color:var(--violet)}
  .eyebrow-c{color:var(--coral)}
  .grid{display:grid;gap:var(--space-4)}
  .card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-panel)}

  .btn{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:var(--radius-md);font-weight:750;font-size:15px;cursor:pointer;border:0;transition:transform .14s ease,filter .14s ease}
  .btn:hover{transform:translateY(-1px);filter:brightness(1.03)}
  .btn-primary{background:var(--grad-primary);color:#fff;box-shadow:0 8px 20px rgba(176,57,217,.22)}
  .btn-ghost-dark{background:rgba(255,255,255,.06);color:#fff;border:1.5px solid rgba(255,255,255,.4)}
  .btn-ghost-dark:hover{border-color:#fff}

  .field-row{display:flex;flex-direction:column;gap:6px;text-align:left;width:100%}
  .field-label{font-size:13px;font-weight:650;color:#c7cce0}
  .field-input{width:100%;padding:12px 16px;border-radius:var(--radius-md);border:1.5px solid rgba(255,255,255,.25);background:rgba(255,255,255,.06);color:#fff;font-family:var(--font-sans);font-size:15px;transition:border-color .14s ease,background .14s ease}
  .field-input::placeholder{color:#8890ab}
  .field-input:focus{outline:none;border-color:#fff;background:rgba(255,255,255,.1)}

  .logo-mark{display:block;flex:0 0 auto}
  .brand-row{display:flex;align-items:center;gap:12px}
  .brand-word{font-size:11px;font-weight:900;letter-spacing:.2em}

  .num-badge{flex:0 0 auto;width:30px;height:30px;border-radius:var(--radius-full);background:var(--grad-primary);color:#fff;font-weight:900;display:flex;align-items:center;justify-content:center;font-size:14px}

  @media (max-width:900px){
    .section{padding:56px 24px}
    .ds-display{font-size:32px}
    .ds-hero{font-size:24px}
  }
</style>
</head>
<body>

<div style="width:100%;min-height:100vh;display:flex;flex-direction:column;">

  <!-- NAV -->
  <div style="width:100%;padding:18px 48px;display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20;">
    <a href="index.html" class="brand-row">
      <svg class="logo-mark" viewBox="0 0 40 48" width="24" height="29" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="afTopNav" x1="3" y1="18" x2="36" y2="3" gradientUnits="userSpaceOnUse"><stop stop-color="#FF8A3D"/><stop offset=".50" stop-color="#FF5B67"/><stop offset="1" stop-color="#F43BA5"/></linearGradient><linearGradient id="afBottomNav" x1="3" y1="45" x2="36" y2="27" gradientUnits="userSpaceOnUse"><stop stop-color="#6731F2"/><stop offset=".60" stop-color="#7C4DFF"/><stop offset="1" stop-color="#A345F0"/></linearGradient></defs><path d="M5 18.5 20 4.5 35 18.5" fill="none" stroke="url(#afTopNav)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 43 20 29 35 43" fill="none" stroke="url(#afBottomNav)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="brand-word" style="color:var(--ink)">AGENT FIRST</div>
    </a>
    <div style="display:flex;align-items:center;gap:20px;">
      <a href="labs.html" class="ds-body-sm nav-link" style="color:var(--ink);font-weight:650;">Free Tools</a>
      <a href="agent-challenge.html" class="ds-body-sm nav-link" style="color:var(--ink);font-weight:650;">Agent Challenge</a>
      <a href="pricing.html" class="ds-body-sm nav-link" style="color:var(--ink);font-weight:650;">Pricing</a>
      <a href="index.html#contact" class="btn btn-primary" style="padding:9px 20px;font-size:14px;">Become a pilot partner</a>
    </div>
  </div>

  <!-- HERO -->
  <div style="width:100%;background:var(--grad-navy);padding:88px 48px 80px;display:flex;justify-content:center;">
    <div style="width:100%;max-width:720px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px;">
      <div class="ds-label eyebrow-c">Free checklist</div>
      <h1 class="ds-display" style="color:#fff;">The Client Profile Setup Checklist</h1>
      <p class="ds-body" style="color:#c7cce0;max-width:600px;">A knowledge base tells an agent where a policy lives. It does not tell them what to do right now, for this specific client, in this exact situation. This is the six-item checklist to gather before you configure a real Client Profile, free, no pilot commitment required to get it.</p>
      <a href="#get-checklist" class="btn btn-primary" style="margin-top:6px;">Get the free checklist</a>
    </div>
  </div>

  <!-- WHAT'S IN IT -->
  <div class="section" style="background:#fff;">
    <div class="wrap" style="display:flex;flex-direction:column;gap:36px;">
      <div style="display:flex;flex-direction:column;gap:12px;max-width:720px;">
        <div class="ds-label eyebrow-v">What's in it</div>
        <h2 class="ds-hero">Six things to gather before your first pilot call.</h2>
        <p class="ds-body" style="color:var(--muted);">One page, nothing to install, and useful whether or not you ever talk to me about a pilot.</p>
      </div>
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
        <div class="card" style="display:flex;flex-direction:column;gap:10px;">
          <div class="num-badge">1</div>
          <div class="ds-body" style="font-weight:750;">Services and eligibility</div>
          <div class="ds-body-sm" style="color:var(--muted);">What an agent can help with, and what makes a specific situation eligible or not.</div>
        </div>
        <div class="card" style="display:flex;flex-direction:column;gap:10px;">
          <div class="num-badge">2</div>
          <div class="ds-body" style="font-weight:750;">Authorization levels</div>
          <div class="ds-body-sm" style="color:var(--muted);">What an agent can decide alone, what needs verification, what's off-limits.</div>
        </div>
        <div class="card" style="display:flex;flex-direction:column;gap:10px;">
          <div class="num-badge">3</div>
          <div class="ds-body" style="font-weight:750;">Required language</div>
          <div class="ds-body-sm" style="color:var(--muted);">Exact wording and disclosures that have to be said, and what an agent should never promise.</div>
        </div>
        <div class="card" style="display:flex;flex-direction:column;gap:10px;">
          <div class="num-badge">4</div>
          <div class="ds-body" style="font-weight:750;">Escalation and transfer rules</div>
          <div class="ds-body-sm" style="color:var(--muted);">Specifically who a situation goes to, not just "escalate."</div>
        </div>
        <div class="card" style="display:flex;flex-direction:column;gap:10px;">
          <div class="num-badge">5</div>
          <div class="ds-body" style="font-weight:750;">Hours, contacts, and routing</div>
          <div class="ds-body-sm" style="color:var(--muted);">Who's reachable when, and what happens outside those hours.</div>
        </div>
        <div class="card" style="display:flex;flex-direction:column;gap:10px;">
          <div class="num-badge">6</div>
          <div class="ds-body" style="font-weight:750;">What "not specified" should mean</div>
          <div class="ds-body-sm" style="color:var(--muted);">The one decision that protects every gap the other five don't catch.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- FORM -->
  <div id="get-checklist" class="section" style="background:var(--grad-navy);padding:96px 48px;">
    <div id="af-form-wrap" style="width:100%;max-width:560px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;">
      <div class="ds-label eyebrow-c">Get the checklist</div>
      <h2 class="ds-hero" style="color:#fff;">Enter your work email and it's yours.</h2>
      <p class="ds-body" style="color:#c7cce0;">No pilot commitment required. If you want to talk about one afterward, I will follow up directly, not an automated sequence.</p>

      <form id="af-checklist-form" style="width:100%;margin-top:20px;display:flex;flex-direction:column;gap:16px;text-align:left;">
        <input type="hidden" name="access_key" value="7207f464-b77a-4a0c-b6b7-3a747ab11496">
        <input type="hidden" name="subject" value="Client Profile checklist request, Agent First">
        <input type="hidden" name="from_name" value="Agent First checklist page">
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

        <div class="field-row">
          <label class="field-label" for="cl-name">Name</label>
          <input class="field-input" id="cl-name" name="name" type="text" required>
        </div>
        <div class="field-row">
          <label class="field-label" for="cl-email">Work email</label>
          <input class="field-input" id="cl-email" name="email" type="email" required>
        </div>
        <div class="field-row">
          <label class="field-label" for="cl-company">Company</label>
          <input class="field-input" id="cl-company" name="company" type="text">
        </div>

        <button type="submit" class="btn btn-primary" style="justify-content:center;margin-top:4px;">Send me the checklist</button>
        <div id="af-form-status" class="ds-body-sm" style="display:none;"></div>
      </form>

      <p class="ds-body-sm" style="color:#8890ab;margin-top:4px;">Prefer email? Write to <a href="mailto:info@myagentfirst.com" style="color:#c7cce0;text-decoration:underline;">info@myagentfirst.com</a> and ask for the checklist directly.</p>
    </div>

    <div id="af-thankyou" style="display:none;width:100%;max-width:560px;flex-direction:column;align-items:center;text-align:center;gap:16px;">
      <div class="ds-label eyebrow-c">You're set</div>
      <h2 class="ds-hero" style="color:#fff;">Here's your checklist.</h2>
      <p class="ds-body" style="color:#c7cce0;">Download it below, and check your inbox, I'll follow up directly if it looks like a fit for a pilot.</p>
      <a href="Agent_First_Client_Profile_Checklist.pdf" download class="btn btn-primary" style="margin-top:6px;">Download the checklist (PDF)</a>
      <a href="pilot-program.html" class="ds-body-sm" style="color:#c7cce0;text-decoration:underline;margin-top:8px;">See what a pilot includes &rarr;</a>
    </div>
  </div>

  <script>
  (function(){
    var form = document.getElementById('af-checklist-form');
    if(!form) return;
    var status = document.getElementById('af-form-status');
    var formWrap = document.getElementById('af-form-wrap');
    var thankyou = document.getElementById('af-thankyou');
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      var originalLabel = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Sending...';
      status.style.display = 'none';
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form)
      }).then(function(res){ return res.json(); }).then(function(data){
        if (data && data.success) {
          formWrap.style.display = 'none';
          thankyou.style.display = 'flex';
        } else {
          btn.disabled = false;
          btn.textContent = originalLabel;
          status.style.color = '#ffb4b4';
          status.textContent = 'Something went wrong. Please try again, or email info@myagentfirst.com directly.';
          status.style.display = 'block';
        }
      }).catch(function(){
        btn.disabled = false;
        btn.textContent = originalLabel;
        status.style.color = '#ffb4b4';
        status.textContent = 'Something went wrong. Please try again, or email info@myagentfirst.com directly.';
        status.style.display = 'block';
      });
    });
  })();
  </script>

  <!-- FOOTER -->
  <div style="width:100%;padding:28px 48px;display:flex;align-items:center;justify-content:space-between;background:#fff;border-top:1px solid var(--line);flex-wrap:wrap;gap:12px;">
    <div class="brand-row">
      <svg class="logo-mark" viewBox="0 0 40 48" width="18" height="22" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="afTopFoot" x1="3" y1="18" x2="36" y2="3" gradientUnits="userSpaceOnUse"><stop stop-color="#FF8A3D"/><stop offset=".50" stop-color="#FF5B67"/><stop offset="1" stop-color="#F43BA5"/></linearGradient><linearGradient id="afBottomFoot" x1="3" y1="45" x2="36" y2="27" gradientUnits="userSpaceOnUse"><stop stop-color="#6731F2"/><stop offset=".60" stop-color="#7C4DFF"/><stop offset="1" stop-color="#A345F0"/></linearGradient></defs><path d="M5 18.5 20 4.5 35 18.5" fill="none" stroke="url(#afTopFoot)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 43 20 29 35 43" fill="none" stroke="url(#afBottomFoot)" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="brand-word" style="color:var(--ink);font-size:12px;">AGENT FIRST</div>
    </div>
    <div class="ds-body-sm" style="color:var(--muted);">Keep the human. Upgrade the agent.</div>
  </div>

</div>
</body>
</html>
